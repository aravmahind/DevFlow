# Infrastructure hostnames below match docker-compose.yml.
REDIS_URL=redis://redis:6379/0
MONGO_URL=mongodb://mongodb:27017

# Supported providers: groq or ollama.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_MODEL_SMART=openai/gpt-oss-120b
LLM_MODEL_FAST=openai/gpt-oss-20b
LLM_MODEL_SECONDARY=openai/gpt-oss-20b
LLM_SECONDARY_AFTER_RETRIES=3
LLM_TIMEOUT_SECONDS=120

# Run a semantic quality review after each schema-valid agent draft. A failed
# review triggers one corrective generation pass. Disable to reduce LLM calls.
LLM_QUALITY_REVIEW=true

# Required when LLM_PROVIDER=groq. GROQ_API is supported only as a legacy alias.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_INTERNAL_API_KEY=replace-with-the-same-long-random-production-secret
RAG_EMBEDDING_PROVIDER=local
# RAG_EMBEDDING_MODEL=text-embedding-3-small

# Used when LLM_PROVIDER=ollama.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Optional per-agent model overrides.
# LLM_MODEL_CEO=
# LLM_MODEL_PRODUCT_MANAGER=
# LLM_MODEL_ARCHITECT=
# LLM_MODEL_SPRINT_PLANNER=
# LLM_MODEL_RISK=
# LLM_MODEL_TEAM_ALLOCATION=
# LLM_MODEL_TIMELINE=
# LLM_MODEL_INTEGRATION=
