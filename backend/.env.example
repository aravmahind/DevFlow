# Infrastructure hostnames below match docker-compose.yml.
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://devflow:devflow@postgres:5432/devflow
AI_SERVICES_URL=http://ai-services:8001
AI_INTERNAL_API_KEY=replace-with-a-long-random-production-secret

# Clerk backend credentials. Never expose CLERK_SECRET_KEY to the browser.
CLERK_SECRET_KEY=
CLERK_ISSUER_URL=https://your-instance.clerk.accounts.dev
BYPASS_AUTH=true
UNLIMITED_CREDENTIALS=true

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# Orchestration settings.
ORCHESTRATOR_WORKERS=1
RUN_TIMEOUT_SECONDS=1800
# Failed runs retry with backoff up to JOB_MAX_ATTEMPTS; a crashed worker's job is
# reclaimed once its lease lapses. Runs stranded longer than AUTO_RESUME_WINDOW_SECONDS
# are marked failed for a manual Retry instead of resuming on their own.
JOB_MAX_ATTEMPTS=4
JOB_LEASE_SECONDS=120
STREAM_IDLE_TIMEOUT_SECONDS=180
AUTO_RESUME_WINDOW_SECONDS=21600
EVENT_BUFFER_TTL_SECONDS=86400

# ---- GitHub repository tracker ----
# Server token: raises the GitHub API limit from 60 to 5000 req/h and is used for
# repos linked without their own token. Fine-grained, read-only Contents + Metadata.
GITHUB_TOKEN=
# Key material for encrypting per-project access tokens at rest (any long random string).
GITHUB_TOKEN_SECRET=
# Publicly reachable backend URL. When set and a link has a token with webhook
# permission, a push webhook is registered automatically; otherwise polling is used.
PUBLIC_API_URL=
GITHUB_POLL_SECONDS=120
# "Connect GitHub" (OAuth App) — lets users link private repos from a list.
# Create one at https://github.com/settings/developers -> OAuth Apps -> New.
# Authorization callback URL must be exactly GITHUB_OAUTH_REDIRECT_URI.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/github/callback
