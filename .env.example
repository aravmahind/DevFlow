# ---- Devflow shared environment ----
# Database (Supabase PostgreSQL connection string)
# Replace with your Supabase database connection string (Session/Transaction pooler or direct connection)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Ports (for Docker and local runs)
PORT_BACKEND=8000
PORT_FRONTEND=3000
PORT_AI=8001

# Public frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Backend -> AI services (http://ai-services:8001 for Docker, http://localhost:8001 for non-Docker)
AI_SERVICES_URL=http://ai-services:8001

# ---- LLM provider ----
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_MODEL_SMART=openai/gpt-oss-120b
LLM_MODEL_FAST=openai/gpt-oss-20b
# Agents fall back to this model once when their primary model errors (deprecated, overloaded, bad output).
LLM_MODEL_SECONDARY=openai/gpt-oss-120b
LLM_QUALITY_REVIEW=false
LLM_TIMEOUT_SECONDS=120

GROQ_API_KEY=your_groq_api_key_here

# Orchestration
ORCHESTRATOR_WORKERS=1
RUN_TIMEOUT_SECONDS=1800
# Failed runs retry with backoff up to JOB_MAX_ATTEMPTS; a crashed worker's job is
# reclaimed once its lease lapses. Runs stranded longer than AUTO_RESUME_WINDOW_SECONDS
# are marked failed for a manual Retry instead of resuming on their own.
JOB_MAX_ATTEMPTS=4
JOB_LEASE_SECONDS=120
STREAM_IDLE_TIMEOUT_SECONDS=180
AUTO_RESUME_WINDOW_SECONDS=21600

# CORS — allow the frontend
CORS_ORIGINS=http://localhost:3100,http://localhost:3010,http://localhost:3000
LOG_LEVEL=INFO

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER_URL=
UNLIMITED_CREDENTIALS=true
NEXT_PUBLIC_UNLIMITED_CREDENTIALS=true
BYPASS_AUTH=false
NEXT_PUBLIC_BYPASS_AUTH=false

# ---- GitHub repository tracker (see backend/.env.example) ----
GITHUB_TOKEN=
GITHUB_TOKEN_SECRET=
PUBLIC_API_URL=
GITHUB_POLL_SECONDS=120
# "Connect GitHub" (OAuth App) — lets users link private repos from a list.
# Create one at https://github.com/settings/developers -> OAuth Apps -> New.
# Authorization callback URL must be exactly GITHUB_OAUTH_REDIRECT_URI.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/github/callback
